/* components/empty-state/empty-state.wxss - 空态样式 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #F2F2F2;
  color: #C4C4C4;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-text {
  font-size: 26rpx;
  color: #8A8A8A;
  margin-top: 20rpx;
}

.empty-sub {
  font-size: 22rpx;
  color: #C4C4C4;
  margin-top: 8rpx;
}
