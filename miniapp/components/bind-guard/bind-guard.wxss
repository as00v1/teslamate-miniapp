/* components/bind-guard/bind-guard.wxss - 未绑定占位样式 */
.guard {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 60rpx;
}

.guard-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #F2F2F2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guard-lock {
  width: 56rpx;
  height: 44rpx;
  background: #C4C4C4;
  border-radius: 8rpx;
  position: relative;
}

.guard-lock::before {
  content: '';
  position: absolute;
  top: -28rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 36rpx;
  height: 36rpx;
  border: 6rpx solid #C4C4C4;
  border-bottom: none;
  border-radius: 20rpx 20rpx 0 0;
}

.guard-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-top: 32rpx;
}

.guard-desc {
  font-size: 24rpx;
  color: #8A8A8A;
  margin-top: 12rpx;
  text-align: center;
  line-height: 1.6;
}

.guard-btn {
  margin-top: 40rpx;
  background: #E82127;
  color: #FFFFFF;
  font-size: 30rpx;
  border-radius: 40rpx;
  padding: 0 80rpx;
  border: none;
}
