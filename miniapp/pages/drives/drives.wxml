<!-- pages/drives/drives.wxml - 行程页：旅程/充电 明细 tab -->
<view class="page">
  <!-- 未绑定引导横幅（布局始终展示，数据为 ? 骨架） -->
  <bind-banner wx:if="{{!bound}}" />

  <!-- 统计卡 -->
  <view class="stats-grid">
    <view class="stat-item">
      <view class="stat-value">{{stats.totalDrives}}</view>
      <view class="stat-label">行程总数</view>
    </view>
    <view class="stat-item">
      <view class="stat-value">{{stats.totalDistanceText}}</view>
      <view class="stat-label">累计里程</view>
    </view>
    <view class="stat-item">
      <view class="stat-value">{{stats.totalEnergyText}}</view>
      <view class="stat-label">累计能耗</view>
    </view>
    <view class="stat-item">
      <view class="stat-value accent">{{stats.avgEfficiencyText}}</view>
      <view class="stat-label">平均电耗</view>
    </view>
  </view>

  <!-- 旅程/充电 tab -->
  <view class="tabs">
    <view class="tab-item {{activeTab === 'drives' ? 'active' : ''}}" bindtap="switchTab" data-tab="drives">旅程</view>
    <view class="tab-item {{activeTab === 'charges' ? 'active' : ''}}" bindtap="switchTab" data-tab="charges">充电</view>
  </view>

  <!-- 旅程明细 -->
  <view class="card" wx:if="{{activeTab === 'drives'}}">
    <view class="card-title">行程明细</view>
    <view class="drive-list">
      <view class="drive-item" hover-class="item-hover" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <view class="drive-top">
          <view class="drive-date">{{item.dateText}}</view>
          <view class="drive-distance">{{item.distanceText}}</view>
        </view>
        <view class="drive-mid">
          <view class="drive-metric">
            <text class="m-label">时长</text>
            <text class="m-value">{{item.durationText}}</text>
          </view>
          <view class="drive-metric">
            <text class="m-label">最高时速</text>
            <text class="m-value">{{item.speedText}}</text>
          </view>
          <view class="drive-metric">
            <text class="m-label">电耗</text>
            <text class="m-value">{{item.energyText}}</text>
          </view>
          <view class="drive-metric">
            <text class="m-label">花费</text>
            <text class="m-value">{{item.costText}}</text>
          </view>
        </view>
        <view class="drive-route">{{item.routeText}}</view>
      </view>
    </view>
    <view class="load-more" wx:if="{{hasMore}}">
      <text class="load-text">{{loadingMore ? '加载中...' : '上拉加载更多'}}</text>
    </view>
    <empty-state wx:if="{{!loading && list.length === 0}}" text="暂无行程记录" />
  </view>

  <!-- 充电明细 -->
  <view class="card" wx:else>
    <view class="card-title">充电明细</view>
    <view class="charge-list">
      <view class="charge-item" hover-class="item-hover" wx:for="{{chargeList}}" wx:key="id" bindtap="goChargeDetail" data-id="{{item.id}}">
        <view class="charge-top">
          <view class="charge-date">{{item.dateText}}</view>
          <view class="charge-tag {{item.tagClass}}">{{item.tagText}}</view>
        </view>
        <view class="charge-mid">
          <view class="charge-metric main">
            <view class="cvalue">{{item.costText}}</view>
            <view class="clabel">费用</view>
          </view>
          <view class="charge-metric">
            <view class="cvalue">{{item.energyText}}</view>
            <view class="clabel">充入</view>
          </view>
          <view class="charge-metric">
            <view class="cvalue">{{item.levelText}}</view>
            <view class="clabel">电量</view>
          </view>
        </view>
        <view class="charge-foot">{{item.footText}}</view>
      </view>
    </view>
    <view class="load-more" wx:if="{{hasMore}}">
      <text class="load-text">{{loadingMore ? '加载中...' : '上拉加载更多'}}</text>
    </view>
    <empty-state wx:if="{{!loading && chargeList.length === 0}}" text="暂无充电记录" />
  </view>
</view>
