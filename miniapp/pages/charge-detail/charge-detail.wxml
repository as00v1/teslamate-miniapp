<!-- pages/charge-detail/charge-detail.wxml - 单次充电详情 -->
<view class="page">
  <!-- 加载中 -->
  <view class="loading-tip" wx:if="{{loading}}">加载中...</view>

  <!-- 错误/未找到 -->
  <view class="error-tip" wx:elif="{{errorText}}">
    <view class="error-title">无法加载充电记录</view>
    <view class="error-sub">{{errorText}}</view>
  </view>

  <block wx:else>
  <!-- 头部：日期 + 大电量 -->
  <view class="head-card">
    <view class="head-date">{{d.dateText}}</view>
    <view class="head-time">{{d.timeRangeText}}</view>
    <view class="head-energy">{{d.energyText}}</view>
    <view class="head-loc">{{d.locationText}} <text class="head-tag {{d.tagClass}}">{{d.tagText}}</text></view>
  </view>

  <!-- 本次充电 -->
  <view class="card">
    <view class="card-title">本次充电</view>
    <view class="metric-grid">
      <view class="metric-item">
        <view class="m-value">{{d.costText}}</view>
        <view class="m-label">费用</view>
      </view>
      <view class="metric-item">
        <view class="m-value">{{d.durationText}}</view>
        <view class="m-label">时长</view>
      </view>
      <view class="metric-item">
        <view class="m-value">{{d.powerAvgText}}</view>
        <view class="m-label">平均功率</view>
      </view>
      <view class="metric-item">
        <view class="m-value">{{d.usedText}}</view>
        <view class="m-label">耗用电量</view>
      </view>
      <view class="metric-item">
        <view class="m-value">{{d.levelStartText}}</view>
        <view class="m-label">起始电量</view>
      </view>
      <view class="metric-item">
        <view class="m-value">{{d.levelEndText}}</view>
        <view class="m-label">结束电量</view>
      </view>
    </view>
  </view>

  <!-- 电池与续航 -->
  <view class="card">
    <view class="card-title">电池与续航</view>
    <view class="info-row">
      <text class="info-label">电量变化</text>
      <text class="info-value">{{d.levelText}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">续航变化</text>
      <text class="info-value">{{d.rangeText}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">车外温度</text>
      <text class="info-value">{{d.tempText}}</text>
    </view>
  </view>
  </block>
</view>
