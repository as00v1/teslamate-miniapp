<!-- pages/index/index.wxml - 首页：车辆状态 + 控制 -->
<view class="page">
  <!-- 未绑定引导横幅（布局始终展示，数据为 ? 骨架） -->
  <bind-banner wx:if="{{!bound}}" />

  <!-- 车辆信息头部 -->
  <view class="car-card">
    <view class="car-info">
      <view class="car-nickname">{{vehicle.nickname}}</view>
      <view class="car-name">{{vehicle.name}}</view>
    </view>
    <view class="car-logo">T</view>
  </view>

  <!-- 状态大卡 -->
  <view class="status-card card" wx:if="{{status}}">
    <view class="status-left">
      <view class="battery-ring" style="background: conic-gradient(#E82127 {{status.charge_level}}%, #EEEEEE {{status.charge_level}}% 100%);">
        <view class="battery-inner">
          <view class="battery-pct">{{statusText.chargeLevel}}</view>
          <view class="battery-sub">电量</view>
        </view>
      </view>
    </view>
    <view class="status-right">
      <view class="status-row">
        <text class="s-label">预估续航</text>
        <text class="s-value">{{statusText.rangeText}}</text>
      </view>
      <view class="status-row">
        <text class="s-label">车内温度</text>
        <text class="s-value">{{statusText.insideTemp}}</text>
      </view>
      <view class="status-row">
        <text class="s-label">车外温度</text>
        <text class="s-value">{{statusText.outsideTemp}}</text>
      </view>
      <view class="status-row">
        <text class="s-label">门锁</text>
        <text class="s-value">{{statusText.lockText}}</text>
      </view>
    </view>
  </view>

  <!-- 实时状态未接入提示（已绑定 + 真实模式显示） -->
  <view class="status-card card" wx:if="{{statusUnavailable && !status && bound}}">
    <view class="pending-tip">
      <view class="pending-title">实时状态待接入</view>
      <view class="pending-sub">当前展示车辆基础信息，电量/位置/温度等实时状态需接入特斯拉官方 API（P1 阶段）</view>
    </view>
  </view>

  <!-- 辅助状态条 -->
  <view class="sub-status card" wx:if="{{status}}">
    <view class="sub-item">
      <view class="sub-value">{{statusText.chargingText}}</view>
      <view class="sub-label">充电</view>
    </view>
    <view class="sub-item">
      <view class="sub-value">{{status.sentry_mode ? '已开启' : '已关闭'}}</view>
      <view class="sub-label">哨兵</view>
    </view>
    <view class="sub-item">
      <view class="sub-value">{{statusText.locationText}}</view>
      <view class="sub-label">位置</view>
    </view>
  </view>

  <!-- 控制按钮区 -->
  <view class="card">
    <view class="card-title">车辆控制</view>
    <view class="ctrl-grid">
      <view class="ctrl-btn {{status && status.locked ? 'on' : ''}}" hover-class="ctrl-hover" bindtap="runCmd" data-cmd="lock" data-label="锁车">
        <view class="ctrl-icon" style="background-image:url('data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23333333%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Crect%20x%3D%225%22%20y%3D%2211%22%20width%3D%2214%22%20height%3D%229%22%20rx%3D%222%22%2F%3E%3Cpath%20d%3D%22M8%2011V7a4%204%200%200%201%208%200v4%22%2F%3E%3C%2Fsvg%3E')"></view>
        <view class="ctrl-text">锁车</view>
      </view>
      <view class="ctrl-btn" hover-class="ctrl-hover" bindtap="runCmd" data-cmd="unlock" data-label="解锁">
        <view class="ctrl-icon" style="background-image:url('data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23333333%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Crect%20x%3D%225%22%20y%3D%2211%22%20width%3D%2214%22%20height%3D%229%22%20rx%3D%222%22%2F%3E%3Cpath%20d%3D%22M8%2011V7a4%204%200%200%201%207.8-1.2%22%2F%3E%3C%2Fsvg%3E')"></view>
        <view class="ctrl-text">解锁</view>
      </view>
      <view class="ctrl-btn" hover-class="ctrl-hover" bindtap="runCmd" data-cmd="climate" data-label="开空调">
        <view class="ctrl-icon" style="background-image:url('data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23333333%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M12%203v18M5%208l7%204%207-4M5%2016l7-4%207%204%22%2F%3E%3C%2Fsvg%3E')"></view>
        <view class="ctrl-text">空调</view>
      </view>
      <view class="ctrl-btn" hover-class="ctrl-hover" bindtap="runCmd" data-cmd="flash" data-label="闪灯">
        <view class="ctrl-icon" style="background-image:url('data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23333333%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M2%2012h20M8%2012l3-8h2l3%208M9.5%2012l1.5%209h2l1.5-9%22%2F%3E%3C%2Fsvg%3E')"></view>
        <view class="ctrl-text">闪灯</view>
      </view>
      <view class="ctrl-btn" hover-class="ctrl-hover" bindtap="runCmd" data-cmd="honk" data-label="鸣笛">
        <view class="ctrl-icon" style="background-image:url('data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23333333%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M4%2010v4a2%202%200%200%200%202%202h2l6%204V4L8%208H6a2%202%200%200%200-2%202z%22%2F%3E%3Cpath%20d%3D%22M18%208a5%205%200%200%201%200%208%22%2F%3E%3C%2Fsvg%3E')"></view>
        <view class="ctrl-text">鸣笛</view>
      </view>
      <view class="ctrl-btn" hover-class="ctrl-hover" bindtap="runCmd" data-cmd="sentry" data-label="切换哨兵">
        <view class="ctrl-icon" style="background-image:url('data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23333333%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M12%203l7%203v5c0%205-3%208-7%2010-4-2-7-5-7-10V6l7-3z%22%2F%3E%3Cpath%20d%3D%22M9%2012l2%202%204-4%22%2F%3E%3C%2Fsvg%3E')"></view>
        <view class="ctrl-text">哨兵</view>
      </view>
    </view>
  </view>

  <view class="footer-note">{{statusText.updatedText}}</view>
</view>