/* pages/bind/bind.wxss - 绑定页样式 */
.bind-page {
  padding: 120rpx 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bind-lock {
  font-size: 96rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #FCEBEB;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.bind-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.bind-desc {
  font-size: 26rpx;
  color: #8A8A8A;
  text-align: center;
  margin-top: 16rpx;
  line-height: 1.6;
}

.bind-input-wrap {
  width: 100%;
  margin-top: 48rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 2rpx solid #E5E5E5;
  padding: 24rpx;
  display: flex;
  align-items: center;
  position: relative;
}

.bind-input {
  flex: 1;
  font-size: 34rpx;
  color: #1A1A1A;
}

.bind-placeholder {
  color: #C4C4C4;
  font-weight: 400;
}

.bind-eye {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #8A8A8A;
  padding: 8rpx 0 8rpx 20rpx;
}

.bind-tip {
  color: #A32D2D;
  font-size: 24rpx;
  margin-top: 20rpx;
}

.bind-btn {
  width: 100%;
  margin-top: 40rpx;
  background: #E82127;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 16rpx;
  border: none;
}

.bind-btn[disabled] {
  background: #F09595;
  color: #FFFFFF;
  opacity: 0.8;
}

.bind-help {
  font-size: 22rpx;
  color: #B4B4B4;
  margin-top: 32rpx;
}
