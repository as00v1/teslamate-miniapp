# server/.env.example - 后端环境变量模板（复制为 .env 或部署时 export）
# ⚠️ 真实值属于敏感信息，切勿提交到仓库（.env 已被 .gitignore 排除）

# ---- 鉴权 ----
# 业务 API 固定 Token（前端 X-API-Token，建议 32 位随机串）
TESLA_API_TOKEN=please-generate-a-32-char-random-token
# 口令登录（车主分享给家人输入）
TESLA_PASSPHRASE=please-set-a-passphrase

# ---- 微信小程序（mp.weixin.qq.com 获取）----
WX_APPID=your-wx-appid
WX_SECRET=your-wx-appsecret

# ---- tesla_app 库（读写，本项目业务数据）----
APP_DB_HOST=teslamate-database-1
APP_DB_PORT=5432
APP_DB_NAME=tesla_app
APP_DB_USER=tesla_app
APP_DB_PASS=please-generate

# ---- teslamate 库（只读，仅 GRANT SELECT）----
TM_DB_HOST=teslamate-database-1
TM_DB_PORT=5432
TM_DB_NAME=teslamate
TM_DB_USER=tesla_readonly
TM_DB_PASS=please-generate
